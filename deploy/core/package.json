{
  "name": "LightTable",
  "description": "LightTable Electron App",
  "version": "0.9.0",
  "main": "main.js",
  "browserWindowOptions": {
    "icon": "img/lticon.png",
    "width": 1024,
    "height": 700,
    "minWidth": 400,
    "minHeight": 400,
    "webPreferences": {
      "webgl": true,
      "webaudio": true,
      "plugins": true,
      "nodeIntegration": true,
      "contextIsolation": false,
      "sandbox": false
    }
  },
  "dependencies": {
    "@electron/remote": "^2.1.3",
    "socket.io": "^4.8.3",
    "tar": "^7.5.16"
  },
  "forkedDependencies": {}
}
